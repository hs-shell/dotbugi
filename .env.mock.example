# mock 빌드(npm run build:mock) 설정 예시 — `cp .env.mock.example .env.mock` 후 수정
# mock 동작(하드코딩 mockData, 캘린더 토큰 만료 재현, 디버그 배지, 짧은 타이머)을 켠다
VITE_MOCK=true

# 실제 LMS 에서 데이터를 가져올 과목 목록 (JSON 배열). 비우면 하드코딩 mockData 만 표시
# courseId 는 LMS 강의 URL 의 id 값
VITE_MOCK_COURSES='[{"courseId":"00000","courseTitle":"예시 과목","prof":"교수명"}]'

# 마감·기간 필터 해제 (지난 학기 과목 테스트용). 값이 있으면 켜지므로 끄려면 이 줄을 삭제
VITE_MOCK_SKIP_DATE_FILTER=true
